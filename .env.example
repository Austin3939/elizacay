# Copy this file to .env and fill in your values, then restart the dev server.
# All VITE_* vars are inlined at BUILD time — on Netlify, set them in
# Site settings → Environment variables and redeploy after any change.
# Never commit .env (it's gitignored). The Storefront token below is a PUBLIC
# token and ends up in the client bundle by design — that's expected.

# ── Shopify (required for live products, cart, and checkout) ──────────────
# Store domain, no https:// and no trailing slash.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Public Storefront API access token. Install the "Headless" app in Shopify,
# then: Admin → Sales channels → Headless → your storefront
#       → Storefront API → Manage → copy the "Public access token".
VITE_SHOPIFY_STOREFRONT_TOKEN=your-public-storefront-access-token

# ── Social links (optional) ─────────────────────────────────────────────
# Leave blank to use the @elizacaystudio defaults baked into src/data/social.js.
# Set these only to point the icons somewhere else. Full URLs, incl. https://.
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=
VITE_PINTEREST_URL=

# ── Newsletter (optional) ───────────────────────────────────────────────
# Form POST endpoint from Mailchimp / Kit / Klaviyo. While blank, the signup
# form shows a success message without sending anything.
VITE_NEWSLETTER_ACTION=
